{
  "name": "mssql-ffi",
  "version": "0.1.0",
  "description": "Promise-based SQL Server client for Node.js built on node:ffi and ODBC",
  "keywords": [
    "database",
    "ffi",
    "mssql",
    "odbc",
    "sql-server",
    "sqlserver"
  ],
  "license": "MIT",
  "author": "Gulshan",
  "files": [
    "dist"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "probe": "node --env-file-if-exists=.env scripts/probe.ts",
    "demo": "node --env-file-if-exists=.env examples/demo.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "publint": "^0.3.25",
    "tsdown": "~0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.1.0"
  }
}
