# Copy to .env (gitignored). Used by `node --run probe`, `node --run demo` and integration tests.
# ODBC Driver 18 encrypts by default; TrustServerCertificate=yes is for local dev only.
MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=master;Trusted_Connection=yes;TrustServerCertificate=yes
